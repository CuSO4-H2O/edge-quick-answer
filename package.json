{
  "name": "edge-quick-answer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Edge 划词答题助手 — 划词/截图提问，DeepSeek 流式作答",
  "scripts": {
    "dev": "node scripts/build.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:quick": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-extract.ts && node scripts/test-shadow-css.mjs && node scripts/test-build-info.mjs && node scripts/test-highlight.mjs && node scripts/test-diagnose.mjs && node scripts/test-panel.mjs && node scripts/test-stale-context.mjs",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test:extract": "node scripts/test-extract.ts",
    "test:panel": "node scripts/test-shadow-css.mjs && node scripts/test-panel.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "test:highlight": "node scripts/test-highlight.mjs",
    "test:build-info": "node scripts/test-build-info.mjs",
    "test:diagnose": "node scripts/test-diagnose.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
